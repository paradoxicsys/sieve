      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Dedup index size (docs)",
      "description": "Grows with kept documents: the only structure whose memory is not bounded by queue sizes.",
      "datasource": {
