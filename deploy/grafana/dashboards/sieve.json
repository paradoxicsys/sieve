          "expr": "sum(rate(sieve_drops_total{rule=~\"dedup.*\"}[1m])) / sum(rate(sieve_dedup_input_total[1m]))",
          "legendFormat": "all"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(sieve_drops_total{rule=\"dedup.exact\"}[1m])) / sum(rate(sieve_dedup_input_total[1m]))",
          "legendFormat": "exact"
